# Kid Game Edu - Mẫu Biến Môi trường (Environment Variables Example)
# Sao chép nội dung này hoặc truyền trực tiếp vào môi trường chạy của bạn.

# ==============================================================================
# CẤU HÌNH SERVER & BACKEND (Spring Boot)
# ==============================================================================
SERVER_PORT=8080

# Chuỗi kết nối MongoDB (Local hoặc MongoDB Atlas Cluster)
# Cục bộ: mongodb://localhost:27017/kid_game_edu
# Atlas:  mongodb+srv://<username>:<password>@<cluster-address>/kid_game_edu?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/kid_game_edu

# ==============================================================================
# CẤU HÌNH BẢO MẬT & JWT (Json Web Token)
# ==============================================================================
# Khóa bí mật tối thiểu 256 bits (32 ký tự trở lên) dùng để ký và xác thực token JWT
JWT_SECRET=kidgameedu_super_secret_jwt_key_2026_at_least_32_characters_long

# Thời gian sống của JWT token tính bằng mili-giây (Mặc định: 86400000 = 24 giờ)
JWT_EXPIRATION_MS=86400000

# ==============================================================================
# TÀI KHOẢN QUẢN TRỊ VIÊN MẶC ĐỊNH (Tự động khởi tạo lần đầu nếu chưa có)
# ==============================================================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password

# Bật/tắt tự động khởi tạo dữ liệu mẫu (1 Game mẫu và 1 Session mã PIN: 123456)
DEMO_SEED_ENABLED=true

# ==============================================================================
# CẤU HÌNH CLOUDINARY (Lưu trữ và tối ưu hóa hình ảnh tải lên)
# ==============================================================================
# Đặt true khi muốn tích hợp lưu trữ hình ảnh trên Cloudinary
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
